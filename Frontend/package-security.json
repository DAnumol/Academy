{
  "name": "enterprise-security-dependencies",
  "description": "Security dependencies for enterprise-grade React template",
  "dependencies": {
    "dompurify": "^3.0.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "cors": "^2.8.5",
    "express-validator": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
