# Application Configuration
VITE_APP_NAME=Academy Admin Dashboard
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# API Configuration
VITE_API_BASE_URL=https://your-api-domain.com/api
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=1000

# Security Configuration
VITE_ENABLE_CSRF=true
VITE_SESSION_TIMEOUT=1800000
VITE_TOKEN_REFRESH_THRESHOLD=300000
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOCKOUT_DURATION=900000

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false
VITE_ENABLE_PERFORMANCE_MONITORING=false
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_NOTIFICATIONS=true

# Third-party Services (Optional)
VITE_GA_MEASUREMENT_ID=
VITE_MIXPANEL_TOKEN=
VITE_SENTRY_DSN=
VITE_DATADOG_API_KEY=
VITE_NEW_RELIC_LICENSE_KEY=

# UI Configuration
VITE_DEFAULT_THEME=system
VITE_ENABLE_SYSTEM_THEME=true
VITE_ENABLE_ANIMATIONS=true
VITE_REDUCED_MOTION=false
VITE_SIDEBAR_COLLAPSED=false
VITE_COMPACT_MODE=false

# Performance Configuration
VITE_ENABLE_LAZY_LOADING=true
VITE_ENABLE_CODE_SPLITTING=true
VITE_ENABLE_SERVICE_WORKER=false
VITE_CACHE_TIMEOUT=300000

# Development Configuration
VITE_DEBUG_MODE=false
VITE_ENABLE_MOCK_DATA=true
VITE_LOG_LEVEL=info